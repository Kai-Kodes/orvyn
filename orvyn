def ensure_cache_directories():
    """Ensure ~/.cache/orvyn directories exist and migrate legacy ~/.cache/cavac data if present."""
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        os.makedirs(CACHE_DIR_LYRICS, exist_ok=True)
        legacy_root = os.path.expanduser("~/.cache/cavac")
        if os.path.isdir(legacy_root):
            legacy_covers = os.path.join(legacy_root, "covers")
            if os.path.isdir(legacy_covers):
                for item in os.listdir(legacy_covers):
                    src = os.path.join(legacy_covers, item)
                    dst = os.path.join(CACHE_DIR, item)
                    if not os.path.exists(dst) and os.path.isfile(src):
                        try:
                            shutil.copy2(src, dst)
                        except Exception:
                            pass
            legacy_lyrics = os.path.join(legacy_root, "lyrics")
            if os.path.isdir(legacy_lyrics):
                for item in os.listdir(legacy_lyrics):
                    src = os.path.join(legacy_lyrics, item)
                    dst = os.path.join(CACHE_DIR_LYRICS, item)
                    if not os.path.exists(dst) and os.path.isfile(src):
                        try:
                            shutil.copy2(src, dst)
                        except Exception:
                            pass
    except Exception:
        pass

