                        vinyl_mgr.update_track(art_path, target_px, cover_w, cover_h)
                    elif art_path and os.path.isfile(art_path):
                        png_bytes = prepare_image_for_display(art_path, target_pixels=(target_px, target_px))
                        if png_bytes:
                            cached_image_seq = make_iterm2_image_escape(png_bytes, cover_w, cover_h)

                # Clear screen cleanly on layout / track transition
                sys.stdout.write("\033[2J")

                # Initial artwork / vinyl frame render
                if show_cover:
                    if vinyl_mgr and vinyl_mgr.frames:
                        sys.stdout.write(f"\033[{img_row};{img_col}H{vinyl_mgr.frames[0]}")
                    elif cached_image_seq:
                        sys.stdout.write(f"\033[{img_row};{img_col}H{cached_image_seq}")
                    else:
                        # Subtle minimalist placeholder
                        r, g, b = cached_accent
                        color = f"\033[38;2;{r};{g};{b}m"
                        mid_row = cover_h // 2
                        mid_col = cover_w // 2
                        for r_idx in range(1, cover_h + 1):
                            curr_r = img_row + r_idx - 1
                            sys.stdout.write(f"\033[{curr_r};{img_col}H")
                            if r_idx == mid_row:
                                pad_l = max(0, mid_col - 1)
                                pad_r = max(0, cover_w - pad_l - 2)
                                sys.stdout.write(f"{' ' * pad_l}{color}♫ {RESET}{' ' * pad_r}")
                            else:
                                sys.stdout.write(" " * cover_w)

                # Invalidate progress & lyrics cache to trigger immediate initial draw
                last_progress_time = 0.0
                last_displayed_lyric_panel = []
                sys.stdout.flush()

            # 1. Tick vinyl rotation animation (25 FPS)
            if show_cover and vinyl_mgr:
                is_playing = (snapshot.get("status", "").lower() == "playing")
                rot_seq = vinyl_mgr.tick(is_playing, now)
                if rot_seq:
                    sys.stdout.write(f"\033[{img_row};{img_col}H{rot_seq}")

            # 2. Render metadata & progress bar (refreshes at 5 Hz or on resize/track change)
            if (now - last_progress_time >= 0.20) or size_changed or track_changed:
                last_progress_time = now
                rotate_no_cover = bool(args.rotate and args.no_cover)
                meta_lines = format_minimalist_metadata(
                    snapshot, meta_w, cached_accent, is_compact,
                    rotate_no_cover_note=rotate_no_cover
                )
                for r_idx, mline in enumerate(meta_lines):
                    row_num = meta_top + r_idx
                    sys.stdout.write(f"\033[{row_num};{meta_col}H{pad_to_width(mline, meta_w)}")

            # 3. Render single active lyric sentence on the right
            if show_lyrics and lyrics_worker:
                lyrics_snap = lyrics_worker.get_snapshot()
                current_pos = snapshot.get("position", 0.0)
                track_len = snapshot.get("length", 0.0)
                active_idx = lyrics_worker.get_active_index(current_pos, track_len)
                if active_idx != last_active_lyric_idx:
                    last_active_lyric_idx = active_idx
                    last_lyric_change_time = now

                lyric_lines = format_single_lyric_panel(
                    lyrics_snap, current_pos, track_len, lyrics_w, cached_accent,
                    is_compact, now, last_lyric_change_time
                )
                if lyric_lines != last_displayed_lyric_panel or size_changed or track_changed:
                    last_displayed_lyric_panel = lyric_lines
                    for r_idx, lline in enumerate(lyric_lines):
                        row_num = meta_top + r_idx
                        sys.stdout.write(f"\033[{row_num};{lyrics_col}H{lline}\033[K")

            # 4. Render spectrum bars (25 FPS)
            header_bottom = max(
                (img_row + cover_h - 1) if show_cover else 0,
                meta_top + (6 if is_compact else 7) - 1
            )
            spectrum_gap = 1 if term_h >= 16 else 0
            spectrum_top = header_bottom + 1 + spectrum_gap
            spectrum_height = max(1, term_h - spectrum_top)

            with cava_lock:
                vals = list(cava_values)

            spectrum_values = expand_bars(vals, term_w)
            heights = [
                max(0, min(spectrum_height, int(v / 1000 * spectrum_height)))
                for v in spectrum_values
            ]

            r, g, b = cached_accent
            accent_bar = f"\033[38;2;{r};{g};{b}m{BAR}{RESET}"

            for row_idx in range(spectrum_height, 0, -1):
                curr_row = spectrum_top + (spectrum_height - row_idx)
                row_chars = []
                for h in heights:
                    if h >= row_idx:
                        row_chars.append(accent_bar)
                    else:
                        row_chars.append(" ")
                sys.stdout.write(f"\033[{curr_row};1H" + "".join(row_chars) + "\033[K")

            sys.stdout.flush()

            # 5. Precise clock sleep to preserve 25 FPS frame pacing
            elapsed_frame = time.monotonic() - now
            sleep_time = max(0.001, tick_interval - elapsed_frame)
            time.sleep(sleep_time)

    except KeyboardInterrupt:
        pass
    finally:
        cleanup()



def parse_arguments(argv=None):
    if argv is None:
        argv = sys.argv[1:]

    parser = argparse.ArgumentParser(
        prog="orvyn",
        description="ORVYN - Cyan CAVA terminal audio visualizer & minimalist music dashboard",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  orvyn                                Classic full-screen animated cyan spectrum
  orvyn -meta                          Minimalist music dashboard with high-res artwork & dynamic theme
  orvyn -meta -rotate                  Rotating circular vinyl record with dynamic theme
  orvyn -meta -lyrics                  Synchronized lyrics panel with live tracking
  orvyn -meta -rotate -lyrics          Complete dashboard: vinyl + metadata + lyrics + spectrum
  orvyn -meta --no-cover               Music dashboard without album artwork
  orvyn -meta --compact                Compact dashboard layout for smaller terminals
"""
    )
    parser.add_argument(
        "-meta", "--meta",
        action="store_true",
        help="Display minimalist music metadata & high-res artwork above spectrum visualizer"
    )
    parser.add_argument(
        "-rotate", "--rotate",
        action="store_true",
        help="Display album artwork as an animated rotating circular vinyl record"
    )
    parser.add_argument(
        "-lyrics", "--lyrics",
        action="store_true",
        help="Display synchronized lyrics panel on the right side of the screen"
    )
    parser.add_argument(
        "--no-cover",
        action="store_true",
        help="Display metadata and progress without album artwork"
    )
    parser.add_argument(
        "--compact",
        action="store_true",
        help="Compact metadata layout"
    )
    parser.add_argument(
        "-v", "--version",
        action="version",
        version="ORVYN 3.2.0"
    )

    args = parser.parse_args(argv)
    if args.no_cover or args.compact or args.rotate or args.lyrics:
        args.meta = True

    return args



def main():
    args = parse_arguments()
    if args.meta:
        run_meta(args)
    else:
        run_classic()


if __name__ == "__main__":
    main()
